# ============================================================
# Backend Environment Variables (.env.example)
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit your real .env file to Git!
# ============================================================

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=replace_with_a_strong_64_char_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Cloudinary (Image Uploads) ───────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (SMTP via Gmail) ───────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=no-reply@yourdomain.org

# ── Admin Credentials (used by setupAdmin.js) ────────────────
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@yourdomain.org
ADMIN_PASSWORD=replace_with_strong_password

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ── Paystack (Payment Gateway) ───────────────────────────────
# Use sk_test_ for development, sk_live_ for production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Sentry (Error Monitoring) ────────────────────────────────
SENTRY_DSN=your_backend_sentry_dsn_here

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
