{
  "name": "sabo-ibadan-foundation-backend",
  "version": "1.0.0",
  "description": "Backend API for Sabo Ibadan Youth Charity Foundation",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watchAll --verbose",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=tests/integration",
    "test:ci": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage",
    "seed": "node src/utils/seeder.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "charity",
    "foundation",
    "donation",
    "volunteer",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Sabo Ibadan Foundation",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.38.0",
    "@sentry/profiling-node": "^10.38.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "slugify": "^1.6.6",
    "speakeasy": "^2.0.0",
    "streamifier": "^0.1.1",
    "winston": "^3.11.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^10.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
