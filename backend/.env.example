# ============================================================
# Backend — Environment Variables
# ============================================================
# SETUP: Run this from the project root:
#   cd Backend
#   cp .env.example .env
#   → then open .env and replace every placeholder value
#
# Ask the team lead for: MongoDB URI, Cloudinary keys,
# Paystack test keys, Google Client ID, Gmail app password.
# ============================================================

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → your cluster → Connect
# → "Connect your application" → copy the connection string
# Replace <username>, <password>, and <dbname>
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/sabo_db?retryWrites=true&w=majority

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── JWT Authentication ────────────────────────────────────────
# Generate your own: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=GENERATE_YOUR_OWN_64_CHAR_HEX_STRING
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── Cloudinary (image uploads) ────────────────────────────────
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (transactional emails) ──────────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password.
# How to get one:
#   1. Google Account → Security → Enable 2-Step Verification
#   2. Security → App Passwords → create one for "Mail"
#   3. Paste the 16-char password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password
EMAIL_FROM=no-reply@saboyouthfoundation.org

# ── Admin Credentials (for setupAdmin.js) ─────────────────────
# Run "node setupAdmin.js" once to create the first admin account
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@saboyouthfoundation.org
ADMIN_PASSWORD=choose_a_strong_password

# ── Rate Limiting (leave defaults for local dev) ──────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ── File Upload (leave defaults) ──────────────────────────────
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ── Paystack (payments) ───────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys
# Use sk_test_ / pk_test_ for local dev. Never use sk_live_ locally.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Google OAuth ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → Credentials
# → OAuth 2.0 Client ID → add http://localhost:5173 to origins
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Sentry (error monitoring — optional for local dev) ────────
# Leave blank if you don't have access. App works fine without it.
SENTRY_DSN=
