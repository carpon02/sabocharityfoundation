# ==============================================================
# .env.example — Sabo Foundation — All Services
# ==============================================================
# 1. Copy this file:    cp .env.example .env
# 2. Fill in ALL values marked as CHANGE_ME or REPLACE_*
# 3. NEVER commit the .env file to version control
# ==============================================================

# ──────────────────────────────────────────────────────────────
# PROJECT / COMPOSE SETTINGS
# ──────────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_PORT=5000
FRONTEND_PORT=5173
ADMIN_PORT=5174

# ──────────────────────────────────────────────────────────────
# MONGODB (docker-compose)
# ──────────────────────────────────────────────────────────────
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_password
MONGO_DB_NAME=charity_db

# ──────────────────────────────────────────────────────────────
# BACKEND — Node.js + Express (/Backend/.env)
# ──────────────────────────────────────────────────────────────

## MongoDB connection (auto-constructed by docker-compose from above vars)
## For standalone backend local dev, set directly:
MONGODB_URI=mongodb://admin:CHANGE_ME_strong_password@localhost:27017/charity_db?authSource=admin

## JWT
# Generate a strong secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

## Cloudinary — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=REPLACE_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_YOUR_API_KEY
CLOUDINARY_API_SECRET=REPLACE_YOUR_API_SECRET

## Email (SMTP — Gmail App Password recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_YOUR_GMAIL@gmail.com
EMAIL_PASSWORD=REPLACE_GMAIL_APP_PASSWORD
EMAIL_FROM=no-reply@saboyouthfoundation.org

## Paystack — https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_REPLACE_YOUR_PAYSTACK_SECRET
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_YOUR_PAYSTACK_PUBLIC

## Admin seed credentials
ADMIN_EMAIL=admin@saboyouthfoundation.org
ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD

## Sentry (Backend) — https://sentry.io
SENTRY_DSN=https://REPLACE_YOUR_BACKEND_SENTRY_DSN@o123456.ingest.sentry.io/123456

## Google Auth
GOOGLE_CLIENT_ID=REPLACE_YOUR_GOOGLE_CLIENT_ID

# ──────────────────────────────────────────────────────────────
# FRONTEND — Vite React App (/frontend)
# ──────────────────────────────────────────────────────────────
# IMPORTANT: Vite bakes VITE_* vars at BUILD time.
# For local dev, set in frontend/.env
# For Docker/K8s, pass as build ARGs (already configured)

VITE_API_URL=http://localhost:5000/api/v1
VITE_FRONTEND_SENTRY_DSN=https://REPLACE_YOUR_FRONTEND_SENTRY_DSN@o123456.ingest.sentry.io/123456

# ──────────────────────────────────────────────────────────────
# ADMIN — Vite React Dashboard (/admin)
# ──────────────────────────────────────────────────────────────
# Same note as frontend — baked at build time.
# For local dev, set in admin/.env

# VITE_API_URL is shared with frontend above
VITE_ADMIN_SENTRY_DSN=https://REPLACE_YOUR_ADMIN_SENTRY_DSN@o123456.ingest.sentry.io/123456
VITE_GOOGLE_CLIENT_ID=REPLACE_YOUR_GOOGLE_CLIENT_ID

# ──────────────────────────────────────────────────────────────
# GITHUB ACTIONS SECRETS (set in repo Settings → Secrets)
# These are NOT environment variables — listed here for reference
# ──────────────────────────────────────────────────────────────
# DOCKER_HUB_USERNAME      — your Docker Hub username
# DOCKER_HUB_TOKEN         — Docker Hub access token (not password)
# VITE_API_URL             — production API URL for image builds
# VITE_SENTRY_DSN_FRONTEND — frontend Sentry DSN for image builds
# VITE_SENTRY_DSN_ADMIN    — admin Sentry DSN for image builds
