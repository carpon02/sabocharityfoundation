# ==============================================================
# Sabo Foundation — Environment Variables
# ==============================================================
#
# HOW TO USE THIS FILE (read before touching anything):
#
#  This file is a TEMPLATE. Your actual secrets live in real
#  .env files that are NEVER committed to Git.
#
#  Each service (Backend, frontend, admin) has its OWN .env file.
#  This root file is just a reference — you don't run anything
#  from here.
#
#  STEP 1: Set up the Backend
#    cd Backend
#    cp .env.example .env
#    → then open Backend/.env and fill in every value
#
#  STEP 2: Set up the Frontend
#    cd frontend
#    cp .env.example .env
#    → frontend/.env only needs VITE_API_URL and public keys
#      (values below marked with [FRONTEND] are for frontend/.env)
#
#  STEP 3: Set up the Admin panel
#    cd admin
#    cp .env.example .env
#    → same as frontend, just the admin version
#
#  STEP 4: Ask the team lead (carpon02) for:
#    - MongoDB Atlas URI
#    - Paystack test keys (sk_test_ / pk_test_)
#    - Cloudinary credentials
#    - Google Client ID
#    - Gmail app password (for email sending)
#    - Sentry DSNs (optional, skip if you don't have access)
#
#  TIP: For local dev, use TEST keys (sk_test_, pk_test_).
#       Never use live keys on your local machine.
#
# ==============================================================


# ==============================================================
# BACKEND  →  copy to Backend/.env
# ==============================================================

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → your cluster → Connect
# It looks like: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/dbname
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/sabo_db?retryWrites=true&w=majority

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── JWT Authentication ────────────────────────────────────────
# Generate your own secret — run this in terminal:
#   node -e "require('crypto').randomBytes(64).toString('hex')"
# Each dev can use their own secret locally.
JWT_SECRET=GENERATE_YOUR_OWN_64_CHAR_HEX_STRING
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ── Cloudinary (handles all image uploads) ───────────────────
# Get from: https://console.cloudinary.com → Dashboard
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email (transactional emails via Gmail) ────────────────────
# IMPORTANT: Do NOT use your regular Gmail password.
# You need a Gmail App Password:
#   1. Go to your Google Account → Security
#   2. Enable 2-Step Verification (required)
#   3. Go to Security → App Passwords → Generate one for "Mail"
#   4. Use that 16-character password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password
EMAIL_FROM=no-reply@saboyouthfoundation.org

# ── Paystack (payment gateway) ────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys
# Use TEST keys for local development (sk_test_ / pk_test_)
# Never use live keys (sk_live_) locally
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Admin Account (seed credentials) ─────────────────────────
# Used by: node Backend/setupAdmin.js
# Sets up the first admin user in the database
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@saboyouthfoundation.org
ADMIN_PASSWORD=choose_a_strong_local_password

# ── Google OAuth ──────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → Credentials
# → Create OAuth 2.0 Client ID (Web application)
# → Add http://localhost:5173 to Authorized origins
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Rate Limiting (leave as-is for local dev) ─────────────────
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# ── File Upload limits (leave as-is) ─────────────────────────
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ── Sentry (error monitoring — optional for local dev) ────────
# Get from: https://sentry.io → your project → Settings → Client Keys
# Leave blank if you don't have access — the app still works without it
SENTRY_DSN=


# ==============================================================
# FRONTEND  →  copy to frontend/.env
# ==============================================================

# ── API URL ───────────────────────────────────────────────────
# For local dev, this points to your local backend.
# Do NOT change this unless your backend runs on a different port.
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_TYPE=user

# ── Paystack public key ───────────────────────────────────────
# Same value as PAYSTACK_PUBLIC_KEY in Backend/.env
# Use the pk_test_ key for local dev
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── Google OAuth ──────────────────────────────────────────────
# Same value as GOOGLE_CLIENT_ID in Backend/.env
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Sentry (optional for local dev) ──────────────────────────
VITE_SENTRY_DSN=


# ==============================================================
# ADMIN PANEL  →  copy to admin/.env
# ==============================================================

# ── API URL ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_TYPE=admin

# ── Google OAuth ──────────────────────────────────────────────
# Same value as GOOGLE_CLIENT_ID in Backend/.env
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ── Sentry (optional for local dev) ──────────────────────────
VITE_SENTRY_DSN=
