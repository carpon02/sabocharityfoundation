# ============================================================
# Frontend — Environment Variables
# ============================================================
# SETUP:
#   cd frontend
#   cp .env.example .env
#   → The defaults below work for local dev as-is,
#     except for VITE_PAYSTACK_PUBLIC_KEY and VITE_GOOGLE_CLIENT_ID
#     which you need from the team lead.
#
# NOTE: All VITE_* variables are baked into the app at build time.
#       Changes here require restarting the dev server (Ctrl+C → npm run dev).
# ============================================================

# ── API URL ───────────────────────────────────────────────────
# Points to your local backend. Keep this as-is for local dev.
VITE_API_URL=http://localhost:5000/api/v1

# ── App type (do not change) ──────────────────────────────────
# Tells the app whether this is the user-facing or admin frontend.
VITE_APP_TYPE=user

# ── Paystack public key ───────────────────────────────────────
# Same pk_test_ key as in Backend/.env → PAYSTACK_PUBLIC_KEY
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── Google OAuth ──────────────────────────────────────────────
# Same value as GOOGLE_CLIENT_ID in Backend/.env
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Sentry (optional — leave blank for local dev) ─────────────
VITE_SENTRY_DSN=
